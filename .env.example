# ─── Database ────────────────────────────────────
DB_USER=customclaw
DB_PASSWORD=changeme

# ─── OpenSearch ──────────────────────────────────
OPENSEARCH_ADMIN_PASSWORD=changeme

# ─── LLM Providers ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=

# ─── Slack (first bot — additional bots configured via bots/*.yaml) ──
CUSTOMCLAW_SLACK_APP_TOKEN=xapp-...
CUSTOMCLAW_SLACK_BOT_TOKEN=xoxb-...

# ─── GitHub ──────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ─── Airflow ─────────────────────────────────────
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=changeme

# ─── Web UI (GitHub OAuth) ───────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Security ────────────────────────────────────
ENCRYPTION_KEY=

# ─── Host Paths (adjust to your system) ──────────
HOST_WORKSPACE_PATH=~/workspace
CLAUDE_CLI_BINARY=~/.local/bin/claude
CLAUDE_CONFIG_DIR=~/.claude
CLAUDE_CREDENTIALS_FILE=~/.claude.json
CODEX_CONFIG_DIR=~/.codex
CONTAINER_HOME=/home/appuser
