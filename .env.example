# ─── Database ────────────────────────────────────
DB_USER=customclaw
DB_PASSWORD=changeme

# ─── OpenSearch ──────────────────────────────────
OPENSEARCH_ADMIN_PASSWORD=changeme

# ─── LLM Providers ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=

# ─── Platform Credentials (optional — configure per platform) ──
CUSTOMCLAW_SLACK_APP_TOKEN=xapp-...
CUSTOMCLAW_SLACK_BOT_TOKEN=xoxb-...

# ─── GitHub ──────────────────────────────────────
GITHUB_TOKEN=ghp_...

# ─── Airflow ─────────────────────────────────────
AIRFLOW_SECRET_KEY=changeme
AIRFLOW_API_USER=admin
AIRFLOW_API_PASSWORD=changeme

# ─── Web UI (GitHub OAuth) ───────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Security ────────────────────────────────────
ENCRYPTION_KEY=

# ─── Auto Update ──────────────────────────────────
# Set COMPOSE_PROFILES=auto-update to enable Watchtower
# COMPOSE_PROFILES=auto-update
WATCHTOWER_SCHEDULE=0 0 4 * * *

# ─── Host Paths (adjust to your system) ──────────
HOST_WORKSPACE_PATH=~/workspace
CLAUDE_CLI_BINARY=~/.local/bin/claude
CLAUDE_CONFIG_DIR=~/.claude
CLAUDE_CREDENTIALS_FILE=~/.claude.json
CODEX_CONFIG_DIR=~/.codex
GEMINI_CONFIG_DIR=~/.gemini
CONTAINER_HOME=/home/appuser

# ─── cli-keeper intervals (optional overrides) ───
# TOKEN_REFRESH_INTERVAL=21600   # 6 hours in seconds
# CLI_UPDATE_INTERVAL=86400      # 24 hours in seconds
